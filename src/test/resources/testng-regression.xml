<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Regression Suite" parallel="classes" thread-count="2" verbose="1">
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.LoginTests"/>
            <class name="tests.dashboard.DashboardTests"/>
        </classes>
    </test>
</suite>
